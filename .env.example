# Copy to .env for local overrides. Environment variables override YAML.
# Never commit real credentials or tokens.
NASDAQ_JIRA_BROWSER__HEADLESS=true
NASDAQ_JIRA_BROWSER__TIMEOUT_MS=30000
NASDAQ_JIRA_BROWSER__STORAGE_STATE_PATH=storage_state.json
NASDAQ_JIRA_CRAWLER__SEARCH_URL=https://jira.example.com/issues/?jql=project%20%3D%20NASDAQ
NASDAQ_JIRA_CRAWLER__MAX_PAGES=10
NASDAQ_JIRA_CRAWLER__PAGE_SIZE=50
NASDAQ_JIRA_DATABASE__PATH=data/nasdaq_jira.sqlite3
NASDAQ_JIRA_LOGGING__LEVEL=INFO
NASDAQ_JIRA_LOGGING__FILE=logs/nasdaq-jira.log
NASDAQ_JIRA_LOGGING__BACKUP_COUNT=14